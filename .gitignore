.env
.env.*
*.pem
*.key
tokens.json
.credentials/

# Runtime output
out/
data/
*.sqlite
*.db
*.log

# Node
node_modules/
dist/
build/
.npm/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
